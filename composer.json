{
    "name": "velirapay/velirapay-php",
    "description": "The official PHP library for VeliraPay crypto payments: charges, payment links, invoices, events and webhook verification.",
    "type": "library",
    "keywords": [
        "velirapay",
        "crypto",
        "payments",
        "payment-gateway",
        "bitcoin",
        "ethereum",
        "solana",
        "webhooks",
        "sdk",
        "api"
    ],
    "homepage": "https://velirapay.com",
    "license": "MIT",
    "authors": [
        {
            "name": "VeliraPay",
            "homepage": "https://velirapay.com"
        }
    ],
    "support": {
        "docs": "https://velirapay.com/docs",
        "issues": "https://github.com/VeliraPay/velirapay-php/issues",
        "source": "https://github.com/VeliraPay/velirapay-php"
    },
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.3 || ^13.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "The HTTP client this library creates when none is given, with the timeout option applied (^7.8)."
    },
    "autoload": {
        "psr-4": {
            "VeliraPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeliraPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "types": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@types",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
